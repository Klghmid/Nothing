    "_meta": {
      "title": "Union type: pose"
    }
  },
  "9": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": [
        "2",
        0
      ],
      "negative": [
        "3",
        0
      ],
      "control_net": [
        "8",
        0
      ],
      "image": [
        "6",
        0
      ],
      "strength": 0.9,
      "start_percent": 0,
      "end_percent": 0.9,
      "vae": [
        "1",
        2
      ]
    },
    "_meta": {
      "title": "Apply pose control"
    }
  },
  "10": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": {
      "title": "Empty canvas"
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "positive": [
        "9",
        0
      ],
      "negative": [
        "9",
        1
      ],
      "latent_image": [
        "10",
        0
      ],
