      "title": "SDXL checkpoint"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "Who is in the pose and where",
      "clip": [
        "1",
        1
      ]
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "lowres, worst quality, low quality, bad anatomy, bad hands, extra fingers, text, watermark, jpeg artifacts, blurry",
      "clip": [
        "1",
        1
      ]
    },
    "_meta": {
      "title": "Negative prompt"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    },
    "_meta": {
      "title": "Pose reference"
    }
  },
  "5": {
    "class_type": "DWPreprocessor",
    "inputs": {
      "image": [
        "4",
        0
