{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    },
    "_meta": {
      "title": "Target image"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "face.png"
    },
    "_meta": {
      "title": "Face photo"
    }
  },
  "3": {
    "class_type": "ReActorFaceSwap",
    "inputs": {
      "enabled": true,
      "input_image": [
        "1",
        0
      ],
      "source_image": [
        "2",
        0
      ],
      "swap_model": "inswapper_128.onnx",
      "facedetection": "retinaface_resnet50",
      "face_restore_model": "codeformer-v0.1.0.pth",
      "face_restore_visibility": 1,
      "codeformer_weight": 0.6,
      "detect_gender_input": "no",
      "detect_gender_source": "no",
      "input_faces_index": "0",
      "source_faces_index": "0",
      "console_log_level": 1
    },
    "_meta": {
      "title": "Face swap (ReActor)"
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    },
    "_meta": {
      "title": "SDXL checkpoint"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "Optional: describe the face (e.g. smiling woman, freckles)",
      "clip": [
        "4",
        1
      ]
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "lowres, worst quality, low quality, bad anatomy, bad hands, extra fingers, text, watermark, jpeg artifacts, blurry",
      "clip": [
        "4",
        1
      ]
    },
    "_meta": {
      "title": "Negative prompt"
    }
  },
  "7": {
    "class_type": "UltralyticsDetectorProvider",
    "inputs": {
      "model_name": "bbox/face_yolov8m.pt"
    },
    "_meta": {
      "title": "Face detector"
    }
  },
  "8": {
    "class_type": "FaceDetailer",
    "inputs": {
      "image": [
        "3",
        0
      ],
      "model": [
        "4",
        0
      ],
      "clip": [
        "4",
        1
      ],
      "vae": [
        "4",
        2
      ],
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "seed": 123456789,
      "steps": 20,
      "cfg": 6,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "guide_size": 1024,
      "guide_size_for": true,
      "max_size": 1024,
      "denoise": 0.25,
      "feather": 5,
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": 0.35,
      "bbox_dilation": 6,
      "bbox_crop_factor": 3,
      "drop_size": 10,
      "bbox_detector": [
        "7",
        0
      ],
      "wildcard": "",
      "cycle": 1,
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False"
    },
    "_meta": {
      "title": "Blend new face (SDXL)"
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "filename_prefix": "WireStudio/sdxl-faceswap"
    },
    "_meta": {
      "title": "Save image"
    }
  }
}
