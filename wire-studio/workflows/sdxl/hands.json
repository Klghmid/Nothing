    "inputs": {
      "image": [
        "4",
        0
      ],
      "model": [
        "1",
        0
      ],
      "clip": [
        "1",
        1
      ],
      "vae": [
        "1",
        2
      ],
      "positive": [
        "2",
        0
      ],
      "negative": [
        "3",
        0
      ],
      "seed": 123456789,
      "steps": 20,
      "cfg": 6,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "guide_size": 1024,
      "guide_size_for": true,
      "max_size": 1024,
      "denoise": 0.45,
      "feather": 5,
      "noise_mask": true,
      "force_inpaint": true,
