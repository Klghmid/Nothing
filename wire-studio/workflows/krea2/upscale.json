{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    },
    "_meta": {
      "title": "Image"
    }
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "krea2_turbo_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Krea 2 model"
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
      "type": "krea2",
      "device": "default"
    },
    "_meta": {
      "title": "Text encoder (Qwen3-VL 4B)"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    },
    "_meta": {
      "title": "Qwen Image VAE"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "Optional: describe the picture for the detail pass",
      "clip": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "5",
        0
      ]
    },
    "_meta": {
      "title": "No negative (CFG 1)"
    }
  },
  "7": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "RealESRGAN_x4plus.safetensors"
    },
    "_meta": {
      "title": "Upscale model"
    }
  },
  "8": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "7",
        0
      ],
      "image": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Upscale with model"
    }
  },
  "9": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "8",
        0
      ],
      "upscale_method": "lanczos",
      "width": 2048,
      "height": 2048,
      "crop": "disabled"
    },
    "_meta": {
      "title": "Exact output size"
    }
  },
  "10": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "9",
        0
      ],
      "vae": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "Encode upscaled image"
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "latent_image": [
        "10",
        0
      ],
      "seed": 123456789,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.3
    },
    "_meta": {
      "title": "Refine detail"
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "filename_prefix": "WireStudio/krea2-upscale"
    },
    "_meta": {
      "title": "Save image"
    }
  }
}
