      "bbox_detector": [
        "3",
        0
      ],
      "image": [
        "2",
        0
      ],
      "threshold": 0.4,
      "dilation": 10,
      "crop_factor": 1,
      "drop_size": 10,
      "labels": "all"
    },
    "_meta": {
      "title": "Find the face"
    }
  },
  "5": {
    "class_type": "SegsToCombinedMask",
    "inputs": {
      "segs": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "Face mask"
    }
  },
  "6": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "krea2_turbo_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Krea 2 model"
    }
  },
  "7": {
    "class_type": "CLIPLoader",
