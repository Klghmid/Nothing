  },
  "12": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "2",
        0
      ],
      "vae": [
        "8",
        0
      ]
    },
    "_meta": {
      "title": "Encode image 2"
    }
  },
  "13": {
    "class_type": "Krea2EditModelPatch",
    "inputs": {
      "model": [
        "9",
        0
      ],
      "source_latent": [
        "11",
        0
      ],
      "source_latent_b": [
        "12",
        0
      ],
      "vae": [
        "8",
        0
      ],
      "source_image": [
        "1",
        0
      ],
      "source_image_b": [
        "2",
        0
      ],
      "target_latent": [
        "10",
        0
      ],
      "fit_mode": "fit",
