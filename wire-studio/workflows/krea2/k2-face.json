    }
  },
  "9": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "6",
        0
      ],
      "lora_name": "krea2/editor/krea2_identity_edit_v1_2.safetensors",
      "strength_model": 1
    },
    "_meta": {
      "title": "Krea 2 Identity Edit LoRA"
    }
  },
  "10": {
    "class_type": "EmptySD3LatentImage",
