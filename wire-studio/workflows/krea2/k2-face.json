  },
  "16": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "13",
        0
      ],
      "positive": [
        "14",
        0
      ],
      "negative": [
        "15",
        0
      ],
      "latent_image": [
        "10",
        0
      ],
      "seed": 123456789,
      "steps": 10,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": {
      "title": "Sampler"
    }
  },
  "17": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "16",
        0
      ],
      "vae": [
        "8",
        0
      ]
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "18": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "17",
        0
      ],
      "filename_prefix": "WireStudio/krea2-k2-face"
