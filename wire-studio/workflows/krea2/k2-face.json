{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    },
    "_meta": {
      "title": "Target photo"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "face.png"
    },
    "_meta": {
      "title": "Identity photo"
    }
  },
  "3": {
    "class_type": "UltralyticsDetectorProvider",
